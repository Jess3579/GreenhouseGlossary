@page
@model PrivacyModel
@{
    ViewData["Title"] = "Privacy";
}

<style>
    .privacy-page {
        background-color: #c8e3ca;
        color: #3d352d;
        font-family: Garamond, Georgia, serif;
        font-size: 20px;
        padding: 40px;
        margin-top: 30px;
        margin-bottom: 30px;
        border: 1px solid #a3c7a6;
        border-radius: 20px;
    }

        .privacy-page h1,
        .privacy-page h2 {
            font-family: Garamond, Georgia, serif;
        }

        .privacy-page h1 {
            font-size: 48px;
        }

        .privacy-page h2 {
            font-size: 28px;
        }

    .privacy-line {
        width: 80px;
        height: 3px;
        background-color: #6f9472;
        margin: 20px auto;
    }

    .privacy-card {
        background-color: #f7f6eb;
        padding: 30px;
        border: 1px solid #a3c7a6;
        border-radius: 15px;
        box-shadow: 0 5px 12px #00000015;
    }

    .privacy-page a {
        color: #3d352d;
    }
</style>

<section class="privacy-page">

    <div class="text-center mb-4">
        <img src="~/images/leaf.svg" alt="" width="90" height="90" />

        <p class="mt-3 mb-2">GREENHOUSE GLOSSARY</p>
        <h1>Privacy</h1>

        <div class="privacy-line"></div>

        <p>How information is used in our application.</p>
    </div>

    <div class="privacy-card mb-4">
        <h2>Information We Store</h2>
        <p class="mb-0">
            Greenhouse Glossary stores plant information, including
            plant names, descriptions, and care needs. The application
            does not currently include user accounts or forms that
            request personal information.
        </p>
    </div>

    <div class="privacy-card mb-4">
        <h2>Links to Other Websites</h2>
        <p class="mb-0">
            Some links take you to other websites, like GitHub.
            Those websites have their own privacy policies.
        </p>
    </div>

    <div class="privacy-card">
        <h2>Questions?</h2>
        <p class="mb-0">
            If you have questions about this project, visit our
            <a asp-page="/Contact">Contact page</a>
            to connect with our team.
        </p>
    </div>

</section>
