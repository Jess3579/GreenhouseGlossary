@page
@model GreenhouseGlossary.Pages.Jessica.IndexModel

@{
    ViewData["Title"] = "Jessica’s Greenhouse";
}

<style>
    body {
        background-image: url('/images/greenhouse-background.jpg');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        background-attachment: fixed;
    }

    .jessica-glossary {
        color: #3d352d;
        font-family: Garamond, Georgia, serif;
        padding: 25px 10px 70px;
        min-height: calc(100vh - 180px);
    }

    .jessica-heading {
        position: relative;
        isolation: isolate;
        width: fit-content;
        max-width: 100%;
        margin: 0 auto 20px;
        padding: 15px 25px;
        text-align: center;
        color: #183b25;
        background: none;
        border: none;
        border-radius: 0;
        box-shadow: none;
        text-shadow: none;
    }

        .jessica-heading::before {
            content: "";
            position: absolute;
            inset: -20px -50px;
            z-index: -1;
            background-color: rgba(247, 246, 235, 0.65);
            backdrop-filter: blur(7px);
            border-radius: 50%;
            mask-image: radial-gradient( ellipse, black 60%, transparent 100% );
        }

        .jessica-heading h1 {
            font-family: Garamond, Georgia, serif;
            font-size: 52px;
            font-weight: bold;
            margin-bottom: 8px;
        }

        .jessica-heading p {
            font-size: 22px;
            margin: 0;
        }

    .jessica-toolbar {
        text-align: right;
        margin-bottom: 15px;
    }

    .jessica-add-button {
        display: inline-block;
        background-color: #544c40;
        color: #f7f6eb;
        padding: 10px 20px;
        font-size: 18px;
        border-radius: 6px;
        text-decoration: none;
    }

        .jessica-add-button:hover {
            background-color: #3d352d;
            color: #f7f6eb;
        }

    .jessica-shelf {
        display: flex;
        align-items: flex-end;
        position: relative;
        padding-bottom: 22px;
        margin-bottom: 65px;
    }

        .jessica-shelf::after {
            content: "";
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 24px;
            background: linear-gradient( #b88959, #95653e 45%, #69452c 46%, #805433 );
            border-top: 3px solid #c59b6c;
            border-bottom: 5px solid #543722;
            border-radius: 4px;
            box-shadow: 0 12px 14px #00000055;
        }

    .jessica-plant {
        position: relative;
        width: 33.333%;
        padding: 0 10px;
        text-align: center;
    }

    .jessica-image-link {
        display: block;
    }

    .jessica-plant-image {
        display: block;
        width: 100%;
        height: 290px;
        object-fit: contain;
        object-position: center bottom;
        filter: drop-shadow(0 8px 5px #00000040);
    }

    .jessica-nameplate {
        position: absolute;
        bottom: -76px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 1;
        width: 85%;
        max-width: 190px;
        background-color: #f7f6eb;
        border: 1px solid #c8b698;
        border-radius: 4px;
        padding: 4px 6px;
        box-shadow: 0 3px 6px #00000025;
    }

        .jessica-nameplate h2 {
            font-family: Garamond, Georgia, serif;
            font-size: 21px;
            margin: 0;
        }

        .jessica-nameplate a {
            color: #3d352d;
            font-size: 17px;
        }

    .jessica-edit-links {
        display: inline;
        margin-left: 8px;
    }

        .jessica-edit-links a {
            font-size: 15px;
            margin: 0 7px;
        }

    .jessica-plant-image[src$="spider-plant.png"] {
        transform: translateY(30px);
    }

    .jessica-plant-image[src$="snake-plant.png"] {
        transform: translateY(15px);
    }

    .jessica-plant-image[src$="golden-pothos.png"] {
        transform: translateY(40px);
    }

    .jessica-controls {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-end;
        justify-content: center;
        gap: 12px;
        padding: 10px 0;
        margin-bottom: 25px;
        background-color: transparent;
    }

    .jessica-control {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

        .jessica-control label {
            position: absolute;
            width: 1px;
            height: 1px;
            padding: 0;
            margin: -1px;
            overflow: hidden;
            clip-path: inset(50%);
            white-space: nowrap;
        }

        .jessica-control input,
        .jessica-control select {
            background-color: #f7f6eb;
            color: #3d352d;
            border: 1px solid #a3c7a6;
            border-radius: 8px;
            padding: 9px;
            font-family: inherit;
            font-size: 18px;
            max-width: 100%;
        }

    .jessica-controls button {
        border: none;
        font-family: inherit;
    }

    .jessica-clear {
        background-color: #3d513b;
        color: #f7f6eb;
        padding: 9px 12px;
        border-radius: 8px;
        font-size: 18px;
        text-shadow: none;
    }

    @@media (max-width: 600px) {
        .jessica-heading h1 {
            font-size: 32px;
        }

        .jessica-plant {
            position: relative;
            width: 33.333%;
            padding: 0 10px;
            text-align: center;
        }

        .jessica-plant-image {
            height: 190px;
        }

        .jessica-nameplate h2 {
            font-family: Garamond, Georgia, serif;
            font-size: 24px;
            margin: 0;
        }

        .jessica-nameplate a {
            font-size: 15px;
        }
    }

    .jessica-sounds {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 12px;
        margin-bottom: 20px;
    }

        .jessica-sounds label {
            background-color: #3d513b;
            color: #f7f6eb;
            padding: 5px 12px;
            border-radius: 12px;
            font-size: 18px;
        }

        .jessica-sounds audio {
            width: 240px;
            height: 35px;
        }
</style>

<section class="jessica-glossary">

    <div class="jessica-heading">
        <h1>My Greenhouse</h1>
        <p>Explore plants and learn how to help them thrive.</p>
    </div>

    <form method="get" asp-page="./Index" class="jessica-controls">

        <div class="jessica-control">
            <label asp-for="SearchString">Plant name</label>
            <input asp-for="SearchString"
                   placeholder="Search plants..." />
        </div>

        <div class="jessica-control">
            <label asp-for="Difficulty">Care difficulty</label>
            <select asp-for="Difficulty">
                <option value="">Difficulty: All</option>
                <option value="Easy">Easy</option>
                <option value="Moderate">Moderate</option>
                <option value="Difficult">Difficult</option>
            </select>
        </div>

        <div class="jessica-control">
            <label asp-for="SortOrder">Sort by name</label>
            <select asp-for="SortOrder">
                <option value="">Name: A–Z</option>
                <option value="name_desc">Name: Z–A</option>
            </select>
        </div>

        <button type="submit" class="jessica-add-button">
            Search
        </button>

        <a asp-page="./Index" class="jessica-clear">Clear</a>

        <a asp-page="./Create" class="jessica-add-button">
            + Add Plant
        </a>

    </form>

    @if (Model.Plant.Count == 0)
    {
        <p class="jessica-heading">No plants to display.</p>
    }

    @for (int i = 0; i < Model.Plant.Count; i += 3)
    {
        <div class="jessica-shelf">
            @foreach (var item in Model.Plant.Skip(i).Take(3))
            {
                <div class="jessica-plant">

                    <a asp-page="./Details"
                       asp-route-id="@item.Id"
                       class="jessica-image-link">

                        @if (!string.IsNullOrWhiteSpace(item.ImagePath))
                        {
                            <img src="@Url.Content(item.ImagePath)"
                                 alt="@item.CommonName"
                                 class="jessica-plant-image" />
                        }
                        else
                        {
                            <img src="~/images/leaf.svg"
                                 alt="@item.CommonName"
                                 class="jessica-plant-image" />
                        }
                    </a>

                    <div class="jessica-nameplate">
                        <h2>@item.CommonName</h2>

                        <a asp-page="./Details"
                           asp-route-id="@item.Id">
                            View details
                        </a>

                    </div>

                </div>
            }
        </div>
    }
</section>

<div class="jessica-sounds">
    <label for="greenhouse-audio">Greenhouse sounds</label>

    <audio id="greenhouse-audio" controls loop preload="none">
        <source src="~/audio/greenhouse-birds.mp3"
                type="audio/mpeg" />
        Your browser does not support audio playback.
    </audio>
</div>