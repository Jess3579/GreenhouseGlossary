<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="~/Images/GreenhouseGlossaryLogo.png" asp-append-version="true" />
    <title>@ViewData["Title"] - GreenhouseGlossary</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GreenhouseGlossary.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm greenhouse-navbar">
            <div class="container">
                <a class="navbar-brand greenhouse-brand" asp-area="" asp-page="/Index">
                    <img src="~/images/GreenhouseGlossaryLogo.png"
                         alt="GreenhouseGlossary logo"
                         class="greenhouse-logo" />
                    <span>Greenhouse<span class="brand-highlight">Glossary</span></span>
                </a>

                <button class="navbar-toggler greenhouse-toggler" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse" id="mainNavbar">
                    <ul class="navbar-nav ms-auto align-items-sm-center">
                        <li class="nav-item">
                            <a class="nav-link greenhouse-link"
                               asp-area="" asp-page="/Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link greenhouse-link"
                               asp-area="" asp-page="/Privacy">Privacy</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link greenhouse-link"
                               asp-area="" asp-page="/Contact">Contact</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link greenhouse-link"
                               asp-area="" asp-page="/Jessica/Index">Jessica</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link greenhouse-link"
                               asp-area="" asp-page="/Alainna/Index">Alainna</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - GreenhouseGlossary - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>