@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Index.css" asp-append-version="true" />
}

<section class="hero-section text-center">
    <h1>Greenhouse Glossary</h1>

    <div class="header-shelf" aria-hidden="true">
        <div class="shelf-board"></div>
        <div class="shelf-bracket shelf-bracket-left"></div>
        <div class="shelf-bracket shelf-bracket-right"></div>
    </div>

    <p class="introduction">
        Explore our plant collections and learn about their classifications and characteristics.
    </p>


</section>

<section class="glossary-section">
    <div class="section-heading">
        <span class="section-eyebrow">YOUR NEXT DISCOVERY</span>
        <h2>Explore Our Glossaries</h2>
        <p>Choose a collection and start exploring.</p>
    </div>

    <div class="row g-4">
        <!-- Jessica's Glossary -->
        <div class="col-md-6">
            <a asp-area=""
               asp-page="/Jessica/Index"
               class="glossary-link glossary-link-jess glossary-card-link">
                <img src="~/Images/JessicasLogo.png" alt="Jessica's Glossary logo" class="glossary-icon" /> 
                <div>
                    <h3>Jess's Glossary</h3>
                    <p>Discover Jessica's collection of plants and their characteristics.</p>
                    <span class="glossary-action"> Explore collection <span aria-hidden="true">→</span>
                    </span>
                </div>
            </a>
        </div>

        <!-- Alainna's Glossary -->
        <div class="col-md-6">
            <a asp-area=""
               asp-page="/Alainna/Index"
               class="glossary-link glossary-link-alainna glossary-card-link">
                <img src="~/Images/AlainnasLogo.png" alt="Alainna's Glossary logo" class="glossary-icon" />
                <div>
                    <h3>Alainna's Glossary</h3>
                    <p>Explore Alainna's collection and grow your botanical knowledge.</p>
                    <span class="glossary-action"> Explore collection <span aria-hidden="true">→</span>
                    </span>
                </div>
            </a>
        </div>
    </div>
</section>

<section class="about-section">
    <div class="about-decoration" aria-hidden="true">─── ❧ ───</div>

    <span class="section-eyebrow">ROOTED IN CURIOSITY</span>
    <h2>A Little About Our Project</h2>

    <p>
        GreenhouseGlossary is a place to discover and learn about different
        plant species. From familiar garden favorites to fascinating botanical
        varieties, our goal is to make learning about plants engaging,
        approachable, and enjoyable.
    </p>
</section>

<section class="features-section">
    <div class="section-heading">
        <div class="about-decoration" aria-hidden="true">─── ❀ ───</div>
        <span class="section-eyebrow">THE WORLD OF BOTANY</span>
        <h2>What Will You Discover?</h2>
        <p>Get to know the details that make every plant special.</p>
    </div>

    <div class="feature-container">
        <article class="feature-card">
            <span class="feature-icon" aria-hidden="true">༺</span>
            <h3>Plant Names</h3>
            <p>Learn common names and scientific names used to identify plants.</p>
        </article>

        <article class="feature-card">
            <span class="feature-icon" aria-hidden="true">✿</span>
            <h3>Plant Information</h3>
            <p>Explore plant characteristics, classifications, and defining features.</p>
        </article>

        <article class="feature-card">
            <span class="feature-icon" aria-hidden="true">༻</span>
            <h3>Plant Diversity</h3>
            <p>Discover the incredible variety of species in the plant kingdom.</p>
        </article>
    </div>
</section>