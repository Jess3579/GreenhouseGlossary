@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<section class="text-center py-5">
    <h1>Greenhouse Glossary</h1>
    @* Add our introduction here. *@
</section>

<section class="row g-4">
    <div class="col-md-4">
        @* Add the first content section here. *@
    </div>

    <div class="col-md-4">
        @* Add the second content section here. *@
    </div>

    <div class="col-md-4">
        @* Add the third content section here. *@
    </div>
</section>

<section class="mt-4">
    <h2>Plants</h2>

    @if (Model.Plants.Count == 0)
    {
        <p>No plants are available yet.</p>
    }
    else
    {
        <ul>
            @foreach (var plant in Model.Plants)
            {
                <li>
                    @plant.CommonName
                    (<em>@plant.ScientificName</em>)
                </li>
            }
        </ul>
    }
</section>