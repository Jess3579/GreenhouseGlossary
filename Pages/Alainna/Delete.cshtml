@page
@model GreenhouseGlossary.Pages.Alainna.DeleteModel

@{
    ViewData["Title"] = "Delete Plant";
}
@section Styles {
    <link rel="stylesheet" href="~/css/Alainna.css" asp-append-version="true" />
}

<main class="plant-index">

    <section class="plant-hero">
        <span class="section-label">GREENHOUSE MANAGEMENT</span>
        <h1>Remove a Plant</h1>
        <p>
            Every plant has a place in the greenhouse.
            Review the details below before removing this plant from your glossary.
        </p>
        <span class="botanical-decoration" aria-hidden="true">❧</span>
    </section>

    <section class="plant-collection">

        <div class="collection-heading">
            <div>
                <span class="section-label">PLEASE CONFIRM</span>
                <h2>Delete Plant</h2>
                <p>This action cannot be undone.</p>
            </div>
        </div>

        <div class="delete-plant-card">

            <div class="delete-warning">
                <span class="warning-symbol" aria-hidden="true">!</span>
                <div>
                    <h3>Are you sure you want to delete this plant?</h3>
                    <p>
                        This will permanently remove the plant from your glossary.
                    </p>
                </div>
            </div>

            <div class="delete-plant-details">

                <div class="delete-detail">
                    <span class="delete-label">Common Name</span>
                    <span class="delete-value">@Model.Plant.CommonName</span>
                </div>

                <div class="delete-detail">
                    <span class="delete-label">Scientific Name</span>
                    <span class="delete-value scientific-name">
                        @Model.Plant.ScientificName
                    </span>
                </div>

                <div class="delete-detail">
                    <span class="delete-label">Description</span>
                    <span class="delete-value">
                        @(string.IsNullOrWhiteSpace(Model.Plant.Description)
                                                ? "Not provided"
                                                : Model.Plant.Description)
                    </span>
                </div>

                <div class="delete-detail">
                    <span class="delete-label">☼ Light Needs</span>
                    <span class="delete-value">
                        @(string.IsNullOrWhiteSpace(Model.Plant.LightNeeds)
                                                ? "Not specified"
                                                : Model.Plant.LightNeeds)
                    </span>
                </div>

                <div class="delete-detail">
                    <span class="delete-label">≋ Watering Needs</span>
                    <span class="delete-value">
                        @(string.IsNullOrWhiteSpace(Model.Plant.WateringNeeds)
                                                ? "Not specified"
                                                : Model.Plant.WateringNeeds)
                    </span>
                </div>

                <div class="delete-detail">
                    <span class="delete-label">♡ Care Difficulty</span>
                    <span class="delete-value">
                        @(string.IsNullOrWhiteSpace(Model.Plant.CareDifficulty)
                                                ? "Not specified"
                                                : Model.Plant.CareDifficulty)
                    </span>
                </div>

                <div class="delete-detail">
                    <span class="delete-label">❧ Soil Preferences</span>
                    <span class="delete-value">
                        @(string.IsNullOrWhiteSpace(Model.Plant.SoilPreferences)
                                                ? "Not specified"
                                                : Model.Plant.SoilPreferences)
                    </span>
                </div>

                <div class="delete-detail">
                    <span class="delete-label">Image Path</span>
                    <span class="delete-value">
                        @(string.IsNullOrWhiteSpace(Model.Plant.ImagePath)
                                                ? "Not provided"
                                                : Model.Plant.ImagePath)
                    </span>
                </div>

                <div class="delete-detail">
                    <span class="delete-label">Care Instructions</span>
                    <span class="delete-value">
                        @(string.IsNullOrWhiteSpace(Model.Plant.CareInstructions)
                                                ? "Not provided"
                                                : Model.Plant.CareInstructions)
                    </span>
                </div>

            </div>

            <form method="post" class="delete-form">
                <input type="hidden" asp-for="Plant.Id" />

                <button type="submit" class="delete-confirm-button">
                    Delete Plant
                </button>

                <a asp-page="./Index" class="delete-cancel-link">
                    Cancel and Return to Glossary
                </a>
            </form>

        </div>

    </section>

</main>
