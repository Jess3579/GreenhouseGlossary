@page
@model GreenhouseGlossary.Pages.Alainna.EditModel

@{
    ViewData["Title"] = "Edit Plant";
}
@section Styles {
    <link rel="stylesheet" href="~/css/Alainna.css" asp-append-version="true" />
}

<main class="plant-index">

    <section class="plant-hero">
        <span class="section-label">GREENHOUSE MANAGEMENT</span>
        <h1>Care for Your Collection</h1>
        <p>
            Plants grow and change, and their information can too.
            Update the details below to keep your glossary current.
        </p>
        <span class="botanical-decoration" aria-hidden="true">❧</span>
    </section>

    <section class="plant-collection">

        <div class="collection-heading">
            <div>
                <span class="section-label">UPDATE YOUR RECORDS</span>
                <h2>Edit Plant Information</h2>
                <p>Make changes to your plant's details and care information.</p>
            </div>
        </div>

        <div class="create-plant-card">

            <form method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger validation-summary"></div>

                <input type="hidden" asp-for="Plant.Id" />

                <div class="create-form-grid">

                    <div class="form-group">
                        <label asp-for="Plant.CommonName"></label>
                        <input asp-for="Plant.CommonName"
                               class="form-control"
                               placeholder="Enter common name" />
                        <span asp-validation-for="Plant.CommonName"
                              class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Plant.ScientificName"></label>
                        <input asp-for="Plant.ScientificName"
                               class="form-control"
                               placeholder="Enter scientific name" />
                        <span asp-validation-for="Plant.ScientificName"
                              class="text-danger"></span>
                    </div>

                    <div class="form-group full-width">
                        <label asp-for="Plant.Description"></label>
                        <textarea asp-for="Plant.Description"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Describe this plant..."></textarea>
                        <span asp-validation-for="Plant.Description"
                              class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Plant.LightNeeds">☼ Light Needs</label>
                        <input asp-for="Plant.LightNeeds"
                               class="form-control"
                               placeholder="e.g., Bright indirect light" />
                        <span asp-validation-for="Plant.LightNeeds"
                              class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Plant.WateringNeeds">≋ Watering Needs</label>
                        <input asp-for="Plant.WateringNeeds"
                               class="form-control"
                               placeholder="e.g., Water weekly" />
                        <span asp-validation-for="Plant.WateringNeeds"
                              class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Plant.CareDifficulty">♡ Care Difficulty</label>
                        <input asp-for="Plant.CareDifficulty"
                               class="form-control"
                               placeholder="e.g., Beginner" />
                        <span asp-validation-for="Plant.CareDifficulty"
                              class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Plant.SoilPreferences">❧ Soil Preferences</label>
                        <input asp-for="Plant.SoilPreferences"
                               class="form-control"
                               placeholder="e.g., Well-draining soil" />
                        <span asp-validation-for="Plant.SoilPreferences"
                              class="text-danger"></span>
                    </div>

                    <div class="form-group full-width">
                        <label asp-for="Plant.ImagePath"></label>
                        <input asp-for="Plant.ImagePath"
                               class="form-control"
                               placeholder="Enter an image path or URL" />
                        <span asp-validation-for="Plant.ImagePath"
                              class="text-danger"></span>
                    </div>

                    <div class="form-group full-width">
                        <label asp-for="Plant.CareInstructions"></label>
                        <textarea asp-for="Plant.CareInstructions"
                                  class="form-control"
                                  rows="4"
                                  placeholder="Update watering, pruning, and other care instructions..."></textarea>
                        <span asp-validation-for="Plant.CareInstructions"
                              class="text-danger"></span>
                    </div>

                </div>

                <div class="create-form-actions">

                    <button type="submit" class="plant-button">
                        Save Changes
                    </button>

                    <a asp-page="./Index" class="back-link">
                        Cancel and Return to Glossary
                    </a>

                </div>

            </form>

        </div>

    </section>

</main>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}